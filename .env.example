# ===== 服务 =====
PORT=8787
# 服务器部署必须 0.0.0.0，否则只有本机能访问
HOST=0.0.0.0

# ===== 七鱼 =====
QIYU_WORKSPACE_URL=https://your-company.qiyukf.com/onsite/monitor
QIYU_DOMAIN=your-company.qiyukf.com
# 监控台里是否嵌入七鱼（默认 false：单独标签打开，避免同账号互踢）
EMBED_WORKSPACE=false
# 监控台顶部显示的七鱼登录账号
QIYU_ACCOUNT_NAME=
# 监控台对外地址：飞书卡片按钮和「查看会话详情」用它
PUBLIC_BASE_URL=http://127.0.0.1:8787
# 不监控的客服（通常是 AI 机器人），多个用英文逗号分隔
IGNORE_AGENTS=AI初号机

# ===== 飞书群自定义机器人 =====
# 飞书群 -> 设置 -> 群机器人 -> 添加自定义机器人，复制 webhook
FEISHU_WEBHOOK=
# 机器人开启了「签名校验」才需要填
FEISHU_SECRET=

# ===== 客服组过滤 =====
# 组过滤已移到扩展端：每台采集机在自己的扩展设置里勾选负责的组
# 服务端保持留空即可；如果填了，会在扩展过滤之后再过滤一次，容易漏消息
MONITOR_GROUPS=

# ===== 告警策略 =====
# low | medium | high
ALERT_MIN_LEVEL=medium
# 同一会话同一等级的冷却分钟数
ALERT_COOLDOWN_MIN=10

# ===== LLM 复核 =====
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# hybrid=规则预筛 + 中高危/重点会话走 LLM；full=全部走 LLM；rules=纯规则
LLM_MODE=hybrid
# 每日总结推送时间（HH:mm）
DAILY_SUMMARY_TIME=23:59

# ===== 数据 =====
DATA_DIR=./data
